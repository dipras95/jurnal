generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(1)
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Trade {
  id            Int      @id @default(autoincrement())
  date          DateTime
  pair          String
  position      String
  strategy      String
  timeframe     String
  leverage      Float
  entry         Float
  sl            Float
  tp            Float
  exit          Float
  linkBefore    String?
  linkAfter     String?
  notes         String?
  riskDollar    Float
  slDistPct     Float
  posSizeDollar Float
  rrPlan        Float
  marginDollar  Float
  status        String
  pnlDollar     Float
  rrActual      Float
  balance       Float
  drawdownPct   Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([pair])
  @@index([strategy])
  @@index([status])
}
